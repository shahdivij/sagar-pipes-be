{
  "kind": "collectionType",
  "collectionName": "benefits",
  "info": {
    "singularName": "benefit",
    "pluralName": "benefits",
    "displayName": "Benefit"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Title": {
      "type": "string"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Details": {
      "type": "customField",
      "customField": "plugin::tinymce.tinymce"
    },
    "products": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::product.product",
      "inversedBy": "benefits"
    },
    "popupIcon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
