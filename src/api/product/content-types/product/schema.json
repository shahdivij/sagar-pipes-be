{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "SEODetails": {
      "type": "component",
      "component": "ancillary.seo-details",
      "repeatable": false
    },
    "Name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "Name"
    },
    "bannerImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "benefits": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::benefit.benefit",
      "mappedBy": "products"
    },
    "product_category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category",
      "inversedBy": "products"
    },
    "ProductPageBuilder": {
      "type": "dynamiczone",
      "components": [
        "ancillary.section"
      ]
    },
    "Accessories": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "TechnicalSpecs": {
      "type": "customField",
      "customField": "plugin::tinymce.tinymce"
    },
    "ContactUsCopy": {
      "type": "component",
      "component": "ancillary.section",
      "repeatable": false
    },
    "ExploreMore": {
      "type": "component",
      "component": "ancillary.explore-more",
      "repeatable": false
    },
    "ProductGallery": {
      "type": "component",
      "component": "ancillary.product-gallery",
      "repeatable": true
    },
    "onHoverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
