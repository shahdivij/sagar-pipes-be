{
  "kind": "collectionType",
  "collectionName": "product_categories",
  "info": {
    "singularName": "product-category",
    "pluralName": "product-categories",
    "displayName": "Product category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "SEODetails": {
      "type": "component",
      "component": "ancillary.seo-details",
      "repeatable": false
    },
    "Name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "Name"
    },
    "bannerImage": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "categoryImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Name2": {
      "type": "string"
    },
    "Section2": {
      "type": "component",
      "component": "ancillary.section",
      "repeatable": false
    },
    "SliderImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "RelatedCollection": {
      "type": "component",
      "component": "ancillary.product-category-collection",
      "repeatable": true
    },
    "ExploreMore": {
      "type": "component",
      "component": "ancillary.section",
      "repeatable": true
    },
    "OtherApplications": {
      "type": "component",
      "component": "ancillary.other-applications",
      "repeatable": true
    },
    "ContactUsCopy": {
      "type": "component",
      "component": "ancillary.section",
      "repeatable": false
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "product_category"
    },
    "onHoverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
