{
  "kind": "collectionType",
  "collectionName": "product_categories",
  "info": {
    "singularName": "product-category",
    "pluralName": "product-categories",
    "displayName": "Product category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "SEODetails": {
      "type": "component",
      "component": "ancillary.seo-details",
      "repeatable": false
    },
    "Name": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "Name"
    },
    "background": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "product_category"
    }
  }
}
