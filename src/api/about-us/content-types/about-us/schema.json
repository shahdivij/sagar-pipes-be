    },
    "whyUs": {
      "type": "component",
      "component": "ancillary.why-us-section",
      "repeatable": false
    },
    "whyChooseUs": {
      "type": "component",
      "component": "ancillary.why-choose-us",
      "repeatable": false
    },
    "ourValuesSection": {
      "type": "component",
      "component": "ancillary.our-values-section",
      "repeatable": false
    },
    "testimonials": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::testimonial.testimonial"
