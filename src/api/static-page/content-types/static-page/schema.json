{
  "kind": "collectionType",
  "collectionName": "static_pages",
  "info": {
    "singularName": "static-page",
    "pluralName": "static-pages",
    "displayName": "Static Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "SEODetails": {
      "type": "component",
      "component": "ancillary.seo-details",
      "repeatable": false
    },
    "Heading": {
      "type": "string"
    },
    "Slug": {
      "type": "uid",
      "targetField": "Heading"
    },
    "BannerImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "Content": {
      "type": "customField",
      "customField": "plugin::tinymce.tinymce"
    }
  }
}
